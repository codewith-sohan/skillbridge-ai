# ==============================================================================
# VERCEL DEPLOYMENT ENVIRONMENT VARIABLES
# Add these variables under your Vercel Project Settings > Environment Variables
# ==============================================================================

# 1. GEMINI_API_KEY (REQUIRED)
# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com).
# Required for Search Grounding (gemini-3.5-flash), Multimodal Vision (gemini-3.1-pro-preview),
# and High Thinking Policy Reasoning (gemini-3.1-pro-preview).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. APP_URL (OPTIONAL)
# Self-referencing URL for callback routing.
APP_URL="https://your-project.vercel.app"
